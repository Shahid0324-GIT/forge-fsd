# Optional hosted inference for new autonomous jobs only.
# Copy this file to .env.local and replace the placeholder locally.
# .env.local is ignored by Git. Keep real keys out of chat and source files.
GROQ_API_KEY=your_key_here
# Choose a credential explicitly; quotas never trigger automatic key rotation.
FORGE_GROQ_KEY_NAME=GROQ_API_KEY
# Optional alternate slot. Select it with FORGE_GROQ_KEY_NAME=GROQ_API_KEY_1.
GROQ_API_KEY_1=your_key_here
